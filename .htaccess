# Apache Rewrite Rules for Clean URLs
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect direct .html requests to clean URLs
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/pages/([^.]+)\.html [NC]
  RewriteRule ^ %1 [R=301,L]
  RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/([^.]+)\.html [NC]
  RewriteRule ^ %1 [R=301,L]

  # Clean URL rewrites to pages folder
  RewriteCond %{DOCUMENT_ROOT}/pages/$1.html -f
  RewriteRule ^([^/]+)/?$ pages/$1.html [L]

  # Fallback to root html
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([^/]+)/?$ $1.html [L]

  # Custom 404 error page
  ErrorDocument 404 /404.html
</IfModule>

