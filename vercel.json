{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/projects", "destination": "/pages/projects.html" },
    { "source": "/projects/:slug", "destination": "/pages/projects/:slug.html" },
    { "source": "/experience", "destination": "/pages/experience.html" },
    { "source": "/project", "destination": "/pages/project.html" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
