{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    { "src": "/projects", "dest": "/projects.html" },
    { "src": "/experience", "dest": "/experience.html" },
    { "src": "/project", "dest": "/project.html" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
