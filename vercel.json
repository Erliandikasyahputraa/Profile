{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/projects", "destination": "/pages/projects.html" },
    { "source": "/projects/:slug", "destination": "/pages/projects/:slug.html" },
    { "source": "/experience", "destination": "/pages/experience.html" },
    { "source": "/project", "destination": "/pages/project.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate, s-maxage=0" },
        { "key": "CDN-Cache-Control", "value": "max-age=0, must-revalidate" },
        { "key": "Vercel-CDN-Cache-Control", "value": "max-age=0, must-revalidate" }
      ]
    }
  ]
}
